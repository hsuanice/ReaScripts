# Whitelist: ignore everything, then allow only what is published to ReaPack.
# Local-only folders (Beta Testing, PRO TOOLS, Tools/Apps, _backup, ...) stay on this Mac.
/*

!/.gitignore
!/.github/
!/.reapack-index.conf
!/README.md
!/MAINTAINING.md
!/CLAUDE.md
!/.dev/
!/index.xml
!/Changelogs/

# Images linked from REAPER forum posts — keep so old links keep working
!/Reaper Forum/

# Beta Testing is NOT part of this public repository: it has its own private repositories
# (hsuanice/Beta-Testing, and hsuanice/REAPER-PT-Sync for "Beta Testing/REAPER PT Sync").
**/.DS_Store

# Published categories
!/Rendering/
!/Items Editing/
!/Items Properties/
!/Selection/
!/Tracks/
!/Metadata/
!/Conform/
!/Various/

# Python helpers installed with Conform List Browser (not the test corpus)
!/Tools/
/Tools/*
!/Tools/otio_to_clb.py
!/Tools/aaf_to_otio.py
!/Tools/subtitle_to_clb.py

# Library: only files used by published packages
!/Library/
/Library/*
!/Library/hsuanice_Library.lua
!/Library/hsuanice_RGWH Core.lua
!/Library/hsuanice_AudioSweet Core.lua
!/Library/hsuanice_AS Preview Core.lua
!/Library/hsuanice_Metadata Embed.lua
!/Library/hsuanice_Metadata Read.lua
!/Library/hsuanice_Hover.lua
!/Library/hsuanice_Mouse.lua
!/Library/hsuanice_Metadata Cache.lua
!/Library/hsuanice_Metadata Rename Core.lua
!/Library/hsuanice_List Table.lua
!/Library/hsuanice_Time Format.lua
!/Library/hsuanice_Metadata Generator.lua
!/Library/hsuanice_CLB Compare Engine.lua
!/Library/hsuanice_EDL Parser.lua
!/Library/hsuanice_Session Fix Core.lua
!/Library/hsuanice_OTIO Bridge.lua
!/Library/hsuanice_Subtitle Bridge.lua
!/Library/hsuanice_Process Exec.lua
!/Library/json.lua

.DS_Store
__pycache__/
